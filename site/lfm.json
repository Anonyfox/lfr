{
  "schemaVersion": 1,
  "url": "https://lfr.email/",
  "language": "en",
  "title": "lfr: your own mail server and newsletters on a $5 VPS",
  "description": "Your own mail server for many domains, with newsletters and their websites, in one Go binary your coding agent runs. No SaaS, no per-subscriber bill.",
  "socialImage": {
    "src": "assets/images/share.png",
    "alt": "A typewritten dispatch form titled lfr with ten DNS records for example.com and red postmarks reading spf=pass, dkim=pass and dmarc=pass."
  },
  "urls": {
    "repo": "https://github.com/Anonyfox/lfr",
    "releases": "https://github.com/Anonyfox/lfr/releases",
    "operations": "https://github.com/Anonyfox/lfr/blob/main/docs/operations.md",
    "license": "https://github.com/Anonyfox/lfr/blob/main/LICENSE",
    "gmailRules": "https://support.google.com/a/answer/81126",
    "sesPricing": "https://aws.amazon.com/ses/pricing/",
    "lfm": "https://lfm.cash/",
    "mit": "https://opensource.org/licenses/MIT",
    "install": "https://lfr.email/install.sh",
    "author": "https://github.com/Anonyfox",
    "analytics": "https://static.cloudflareinsights.com/beacon.min.js",
    "impressum": "https://lab.anonyfox.com/impressum/",
    "privacy": "https://lab.anonyfox.com/datenschutz/"
  },
  "data": {
    "install": "curl -fsSL https://lfr.email/install.sh | sudo sh",
    "example": {
      "domain": "example.com",
      "readers": 1000,
      "issues": 4
    },
    "bill": {
      "server": 5,
      "serverLabel": "a $5 VPS",
      "sesPerThousand": 0.16,
      "smtp2goFree": "1,000",
      "exampleRelay": "0.64",
      "exampleTotal": "5.64"
    },
    "compare": [
      {
        "name": "beehiiv Lite",
        "price": "$49 a month at 1,000 subscribers, billed yearly"
      },
      {
        "name": "Buttondown",
        "price": "free for 100 subscribers, then add-on tiers of $9 and $29 a month"
      },
      {
        "name": "Kit",
        "price": "free up to 10,000 subscribers, paid from $33 a month"
      },
      {
        "name": "Ghost, self-hosted",
        "price": "free software, plus Mailgun from $35 a month for bulk mail"
      }
    ],
    "facts": {
      "memory": "25 MB"
    }
  },
  "build": {
    "browserData": [
      "data.bill",
      "data.example"
    ],
    "assets": {
      "overrides": {
        "assets/agents/SKILL.md": "file",
        "assets/agents/install.sh": "file",
        "assets/agents/llms.txt": "file"
      }
    }
  },
  "jsonld": {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "lfr",
    "description": "{{.description}}",
    "url": "{{.url}}",
    "applicationCategory": "CommunicationApplication",
    "operatingSystem": "Linux, macOS",
    "license": "{{.urls.mit}}",
    "codeRepository": "{{.urls.repo}}",
    "downloadUrl": "{{.urls.install}}",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@type": "Person",
      "name": "Maximilian Stroh",
      "url": "{{.urls.author}}"
    }
  }
}
